---
// Moving: the destination sets the price (rulebook figure "A move").
// A path from START over three elevations, with the cost and gear of each step, two tiles you can't enter,
// and Lena's 8 Energy paid out step by step.
import Icon from '../Icon.astro';
import Energy from './Energy.astro';
import { terrain, tileSrc, gearName, type Terrain } from '../../data/game';
import { asset } from '../../data/site';
import { START_TILES } from '../../scripts/board';

const find = (e: number, id: string) => terrain.find((t) => t.elevation === e && t.id === id)!;
const needs = (t: Terrain) => (t.gear === 'lava' ? [] : t.gear);

const path = [
  { t: find(1, 'clear-meadow'), label: 'Elevation 1', cost: 2 },
  { t: find(2, 'snow'), label: 'Elevation 2', cost: 2 },
  { t: find(3, 'snowfield'), label: 'Elevation 3', cost: 4 },
];
const rock = find(2, 'rock');
const lava = find(1, 'lava');
---
<figure class="diagram move">
  <div>
    <p class="diagram-title">The destination sets the price</p>
    <p>Pay the elevation of every tile you enter, and own the gear it shows. Going down costs the same as going up.</p>
  </div>

  <ol class="path">
    <li class="start">
      <img src={asset(START_TILES[0])} alt="START tile" width="120" height="104" loading="lazy" />
      <strong>START</strong>
    </li>
    {path.map((p) => (
      <li>
        <img src={asset(tileSrc(p.t))} alt={p.t.name} width="120" height="104" loading="lazy" />
        <strong>{p.label}</strong>
        <Energy n={p.cost} />
        <span class="needs">
          {needs(p.t).length
            ? needs(p.t).map((g) => <span class="gear-chip"><Icon name={g} size="1.1em" />{gearName[g]}</span>)
            : <small>no gear needed</small>}
        </span>
      </li>
    ))}
  </ol>

  <div class="blocked">
    <div>
      <img src={asset(tileSrc(rock))} alt="Rock tile" width="120" height="104" loading="lazy" />
      <p><strong>Rock</strong> needs Ice Axe and Rope. No Axe: no entry.</p>
    </div>
    <div>
      <img src={asset(tileSrc(lava))} alt="Lava tile" width="120" height="104" loading="lazy" />
      <p><strong>Lava</strong> can never be entered. Go around it.</p>
    </div>
  </div>

  <div class="budget">
    <p>Lena has <Energy n={8} /> and owns Boots, Rope and Tent:</p>
    <div class="bar" role="img" aria-label="2 Energy for the meadow, 2 for the snow, 4 for the snowfield: 8 Energy, three steps this turn.">
      <span class="e1" style="flex:2">2 meadow</span>
      <span class="e2" style="flex:2">2 snow</span>
      <span class="e3" style="flex:4">4 snowfield</span>
    </div>
    <p class="result">= 8, three steps this turn ✓</p>
  </div>
</figure>

<style>
  .path { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-s); }
  @media (max-width: 40rem) { .path { grid-template-columns: repeat(2, 1fr); } }
  .path li { position: relative; display: grid; justify-items: center; align-content: start; gap: 0.2rem; text-align: center; font-size: var(--step--1); }
  .path li + li::before {
    content: '→'; position: absolute; left: calc(-1 * var(--s-s) / 2); top: 2.4rem; translate: -50% 0;
    color: var(--ink-soft); font-size: var(--step-1);
  }
  @media (max-width: 40rem) { .path li:nth-child(3)::before { display: none; } }
  .path img { width: min(100%, 6.854rem); height: auto; filter: drop-shadow(0 3px 4px rgb(34 48 60 / 0.25)); }
  .path :global(.energy) { font-size: var(--step-1); }
  .needs { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.2rem; }
  .needs small { color: var(--ink-soft); }
  .needs :global(.gear-chip) { font-size: var(--step--2); }

  .blocked { display: grid; gap: var(--s-s); }
  @media (min-width: 40rem) { .blocked { grid-template-columns: 1fr 1fr; } }
  .blocked > div { display: grid; grid-template-columns: 4.236rem 1fr; gap: var(--s-s); align-items: center; }
  .blocked img { width: 100%; height: auto; filter: grayscale(0.2) drop-shadow(0 2px 3px rgb(34 48 60 / 0.25)); }
  .blocked p { font-size: var(--step--1); color: var(--lava); }
  .blocked strong { color: var(--ink); }

  .budget { display: grid; gap: var(--s-2xs); font-size: var(--step--1); }
  .bar { display: flex; gap: 2px; height: 2rem; max-width: 34rem; }
  .bar span {
    display: grid; place-items: center;
    color: #fff; font-weight: 700; font-size: var(--step--2); white-space: nowrap;
    background: var(--c);
  }
  .bar span:first-child { border-radius: 4px 0 0 4px; }
  .bar span:last-child { border-radius: 0 4px 4px 0; }
  .result { font-weight: 700; color: var(--forest); }
</style>
