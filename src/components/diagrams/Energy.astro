---
// An Energy amount: the number with a lightning bolt, in summit gold (as on the rulebook figures).
// <Energy n={2} />  →  2⚡
interface Props { n: number | string }
const { n } = Astro.props;
---
<span class="energy">
  {n}<svg viewBox="0 0 24 24" width="0.9em" height="0.9em" aria-hidden="true"><path d="M13.5 2 5 13.5h6l-1.5 8.5L18 10.5h-6z" /></svg>
  <span class="visually-hidden">Energy</span>
</span>

<style>
  .energy { display: inline-flex; align-items: center; gap: 0.05em; font-weight: 700; color: var(--gold); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .energy svg { fill: currentColor; }
</style>
