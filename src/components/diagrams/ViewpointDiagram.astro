---
// Photographing a viewpoint (rulebook figure), in three pictures: stop on it, pay 1, collect.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Energy from './Energy.astro';
import { terrain, tileSrc } from '../../data/game';
import { asset } from '../../data/site';
import ticket from '../../assets/cards/ticket-summit-permit.png';

const water = terrain.find((t) => t.elevation === 1 && t.id === 'water')!;
---
<figure class="diagram viewpoint">
  <p class="diagram-title">Viewpoints: photograph for a Golden Ticket</p>

  <ol class="row">
    <li>
      <img src={asset(tileSrc(water, true))} alt="A viewpoint tile, with the camera icon" width="120" height="104" loading="lazy" />
      <small>End your move on a viewpoint</small>
    </li>
    <li>
      <span class="camera"><Icon name="camera" size="2.618rem" /></span>
      <small>Own the Camera, pay <Energy n={1} /></small>
    </li>
    <li class="result">
      <div class="outcome">
        <Image src={ticket} alt="A Golden Ticket" widths={[160, 320]} sizes="3.236rem" />
        <small>First photo: a Golden Ticket</small>
      </div>
      <div class="outcome">
        <span class="plus3"><Energy n="+3" /></span>
        <small>Already taken: 3 Energy</small>
      </div>
    </li>
  </ol>
</figure>

<style>
  .row { list-style: none; padding: 0; display: grid; gap: var(--s-s); align-items: center; }
  @media (min-width: 40rem) { .row { grid-template-columns: 1fr 1fr 1.618fr; } }
  .row > li { position: relative; display: grid; justify-items: center; gap: var(--s-2xs); text-align: center; }
  @media (min-width: 40rem) {
    .row > li + li::before { content: '→'; position: absolute; left: calc(-1 * var(--s-s) / 2); top: 35%; translate: -50% 0; color: var(--ink-soft); font-size: var(--step-1); }
  }
  .row img { width: 5.5rem; height: auto; filter: drop-shadow(0 3px 4px rgb(34 48 60 / 0.25)); }
  .camera { display: grid; place-items: center; width: 4.236rem; height: 4.236rem; border-radius: var(--r-m); background: #fff; border: 1px solid var(--line); }
  small { font-size: var(--step--1); color: var(--ink-soft); line-height: 1.3; max-width: 11rem; }
  .result { grid-auto-flow: column; justify-content: center; gap: var(--s-m); }
  .outcome { display: grid; justify-items: center; gap: var(--s-2xs); }
  .outcome :global(img) { width: 3.236rem; height: auto; border-radius: 0.2rem; box-shadow: var(--shadow); rotate: 3deg; }
  .plus3 { display: grid; place-items: center; height: 4.5rem; font-size: var(--step-3); }
</style>
