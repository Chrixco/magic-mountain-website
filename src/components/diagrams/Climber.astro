---
// A climber figure in a player colour.
interface Props { color?: string; size?: string }
const { color = '#c8372d', size = '1.618rem' } = Astro.props;
---
<svg class="climber" viewBox="0 0 24 32" width={size} height={size} aria-hidden="true">
  <circle cx="12" cy="7" r="5" fill={color} />
  <path d="M4 30c0-9 2.5-15 8-15s8 6 8 15z" fill={color} />
  <path d="M3 30h18" stroke="rgb(0 0 0 / 0.25)" stroke-width="2" stroke-linecap="round" />
</svg>
