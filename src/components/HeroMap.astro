---
// The hero's living map. The first mountain is rendered on the server (CSS animates it, no JavaScript needed);
// the script then draws a new mountain every so often, and on request.
import { composeMap } from '../scripts/heroMap';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const SEED = 1618;
const first = composeMap(SEED, base);
---
<div class="hero-map" data-hero-map data-base={base} data-duration={first.duration}>
  <svg viewBox={first.viewBox} preserveAspectRatio="xMidYMid meet" role="img" aria-label="An ink drawing of a mountain of hexagonal frames, partly built with terrain tiles: meadows, water, rock, snow, ice and lava, with START tiles at the foot and the golden Summit at the top." data-hero-svg set:html={first.svg} />
  <button type="button" class="redraw" data-redraw>
    <svg viewBox="-24 -24 48 48" width="1.272em" height="1.272em" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M -16,-8 h 8 q 6,0 10,8 q 4,8 10,8 h 6"/><path d="M -16,8 h 8 q 6,0 10,-8 q 4,-8 10,-8 h 6"/><path d="M 13,-13 l 5,5 l -5,5"/><path d="M 13,3 l 5,5 l -5,5"/></svg>
    Draw another mountain
  </button>
</div>

<style>
  .hero-map { position: relative; }
  .hero-map > svg { display: block; width: 100%; height: 100%; overflow: visible; transition: opacity 0.9s var(--ease); }
  .hero-map > svg.out { opacity: 0; }

  .redraw {
    position: absolute; right: var(--s-s); bottom: var(--s-s);
    display: inline-flex; align-items: center; gap: var(--s-2xs);
    min-height: 2.618rem; padding: var(--s-2xs) var(--s-m);
    border: 1px solid var(--glass-edge); border-radius: 999px;
    background: var(--glass-fill);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    font-weight: 600; font-size: var(--step--1); color: var(--ink);
    cursor: pointer;
  }
  @media (max-width: 56rem) {
    .hero-map > svg { height: auto; aspect-ratio: 1.618; }
    .redraw { position: static; margin: var(--s-xs) auto 0; display: flex; width: max-content; }
  }
  .redraw:hover { background: var(--glass-hover-fill); color: var(--forest); }

  /* Ink — draws itself in, elevation by elevation */
  .hero-map :global(.ink),
  .hero-map :global(.guides) {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    /* the line draws itself while its ink slowly darkens from nothing, so frames appear softly */
    animation: ink-draw 1.618s var(--ease) both, tile-fade 2.618s cubic-bezier(.4, 0, .2, 1) both;
    animation-delay: var(--d, 0s), var(--d, 0s);
  }
  .hero-map :global(.ink.fine) { stroke: rgb(91 58 36 / 0.42); stroke-width: 0.8px; }
  .hero-map :global(.ink.bold) { stroke: rgb(91 58 36 / 0.78); stroke-width: 1.6px; }
  .hero-map :global(.guides) { stroke: rgb(91 58 36 / 0.3); stroke-width: 0.8px; --d: 0s; animation-duration: 2.618s, 3.236s; }
  .hero-map :global(.dot) { fill: none; stroke: rgb(91 58 36 / 0.5); stroke-width: 1; vector-effect: non-scaling-stroke; animation: fade 1.618s cubic-bezier(.4, 0, .2, 1) 0.4s both; }

  /* Tiles — dropped into place along the paths, with a little relief */
  .hero-map :global(.tiles) { filter: drop-shadow(0 3px 3px rgb(34 48 60 / 0.28)); }
  .hero-map :global(.tile) {
    transform-box: fill-box; transform-origin: center;
    /* opacity and movement run on separate curves: the tile settles quickly but its alpha rises slowly and evenly */
    animation: tile-fade 1.618s cubic-bezier(.4, 0, .2, 1) both, tile-settle 1s var(--ease) both;
    animation-delay: var(--d, 0s), var(--d, 0s);
  }

  .hero-map :global(.mark) { transform-box: fill-box; transform-origin: center; animation: tile-fade 1.618s cubic-bezier(.4, 0, .2, 1) both, mark-in 1s var(--ease) both; animation-delay: var(--d, 0s), var(--d, 0s); }
  .hero-map :global(.mark polygon) { stroke-width: 3; }
  .hero-map :global(.summit) { filter: drop-shadow(0 4px 5px rgb(107 69 18 / 0.45)); }
  .hero-map :global(.summit polygon) { fill: none; stroke: var(--gold); stroke-width: 4; }
  .hero-map :global(.start polygon) { fill: #fff; stroke: #2f5ea8; }
  .hero-map :global(.start text) { fill: #2f5ea8; font: 700 13px var(--font-body); letter-spacing: 0.04em; }

  @keyframes ink-draw { from { stroke-dashoffset: 1; } }
  @keyframes fade { from { opacity: 0; } }
  @keyframes tile-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes tile-settle { from { transform: translateY(-10px) scale(1.05); } }
  @keyframes mark-in { from { transform: scale(0.854); } }

  @media (prefers-reduced-motion: reduce) {
    .hero-map :global(*) { animation: none !important; }
    .hero-map > svg { transition: none; }
  }
</style>

<script>
  import { composeMap } from '../scripts/heroMap';

  const root = document.querySelector<HTMLElement>('[data-hero-map]');
  if (root) {
    const svg = root.querySelector<SVGSVGElement>('[data-hero-svg]')!;
    const base = root.dataset.base!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const HOLD = 9; // seconds a finished mountain stays before the next one is drawn
    let timer = 0;
    let visible = true;
    let due = false;

    const schedule = (seconds: number) => {
      clearTimeout(timer);
      if (reduce.matches) return;
      timer = window.setTimeout(() => (visible ? redraw() : (due = true)), seconds * 1000);
    };

    function redraw() {
      due = false;
      svg.classList.add('out');
      window.setTimeout(() => {
        const map = composeMap(Math.floor(Math.random() * 2 ** 31), base);
        svg.setAttribute('viewBox', map.viewBox);
        svg.innerHTML = map.svg;
        svg.classList.remove('out');
        schedule(map.duration + HOLD);
      }, reduce.matches ? 0 : 900);
    }

    root.querySelector('[data-redraw]')!.addEventListener('click', redraw);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && due) redraw();
    }).observe(root);
    schedule(Number(root.dataset.duration) + HOLD);
  }
</script>
