---
// Four elevations, highest first: frame colour, cost of a step, and one tile of every terrain type.
import { elevations, terrain, tileSrc, gearName, type Terrain } from '../../data/game';
import { asset } from '../../data/site';

const terrainAt = (level: number) => terrain.filter((t) => t.elevation === level);
const describe = (t: Terrain) =>
  t.gear === 'lava' ? `${t.name}: impassable` : `${t.name}: ${t.gear.length ? t.gear.map((g) => gearName[g]).join(', ') : 'no gear'}`;
---
<section class="section" id="how">
  <div class="wrap">
    <div class="section-head">
      <h2>Four elevations, read at a glance</h2>
      <p>
        The colour of the frame under your feet tells you the elevation, the price of a step, and which bag feeds
        it. Every tile prints the icons of exactly the gear you need to enter it, so the board teaches the rules.
      </p>
    </div>

    <ol class="levels" reversed>
      {elevations.map((el) => (
        <li class={`level glass e${el.level}`}>
          <div class="level-head">
            <span class="hex-badge" aria-hidden="true">{el.level}</span>
            <div>
              <h3>Elevation {el.level}</h3>
              <p class="muted">{el.frame} frame. {el.terrain}</p>
            </div>
            <p class="cost"><strong>{el.cost}</strong> Energy a step</p>
          </div>
          <ul class="level-tiles" aria-label={`Terrain at Elevation ${el.level}`}>
            {terrainAt(el.level).map((t) => (
              <li title={describe(t)}>
                <img src={asset(tileSrc(t))} alt={t.name} width="120" height="104" loading="lazy" decoding="async" data-tilt="tile" />
                <span>{t.name}<small> ×{t.copies + t.viewpoint}</small></span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .levels { list-style: none; padding: 0; display: grid; gap: var(--s-xs); }
  .level {
    display: grid; gap: var(--s-s);
    padding: var(--s-m);
    border-radius: var(--r-l);
    /* glass, tinted with the elevation colour and a stripe on the left */
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 14%, transparent), transparent 61.8%), var(--glass-fill);
    box-shadow: var(--glass-shadow), inset 0.382rem 0 0 var(--c);
  }
  @media (min-width: 56rem) {
    .level { grid-template-columns: 1fr 1.618fr; align-items: center; }
  }

  .level-head { display: grid; grid-template-columns: auto 1fr; gap: var(--s-2xs) var(--s-s); align-items: start; }
  .level-head p { font-size: var(--step--1); }
  .cost { grid-column: 2; font-size: var(--step--1); color: var(--ink); }
  .cost strong { font-family: var(--font-display); font-weight: 400; font-size: var(--step-2); margin-right: 0.15em; }

  .level-tiles {
    list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 5.5rem), 1fr)); gap: var(--s-xs);
  }
  .level-tiles li {
    display: grid; justify-items: center; align-content: start; gap: var(--s-3xs);
    text-align: center; font-size: var(--step--1); line-height: 1.3; color: var(--ink-soft);
  }
  .level-tiles img {
    width: min(100%, 5.5rem);
    filter: drop-shadow(0 2px 3px rgb(34 48 60 / 0.25));
    transition: transform var(--t-slow) var(--ease), scale var(--t-mid) var(--ease), filter var(--t-mid);
  }
  .level-tiles img.tilting { scale: 1.12; filter: drop-shadow(0 8px 8px rgb(34 48 60 / 0.3)); }
  .level-tiles small { font-size: 1em; opacity: 0.8; white-space: nowrap; }
</style>
