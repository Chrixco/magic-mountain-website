---
// How to play: the rulebook in four tabs (setup, your turn, moving, winning).
// Source: Magic_Mountain_Rulebook (§4 Setup, §5 Playing the Game, §6 Movement, §7 Winning). Without JavaScript
// the four parts simply show one after another.
import Icon from '../Icon.astro';
import SetupDiagram from '../diagrams/SetupDiagram.astro';
import RoundDiagram from '../diagrams/RoundDiagram.astro';
import MoveDiagram from '../diagrams/MoveDiagram.astro';
import ViewpointDiagram from '../diagrams/ViewpointDiagram.astro';
import SummitDiagram from '../diagrams/SummitDiagram.astro';
import TurnExample from '../diagrams/TurnExample.astro';
import MoveRules from '../diagrams/MoveRules.astro';
import WinDiagram from '../diagrams/WinDiagram.astro';
import { elevations, mountains } from '../../data/game';
import { video } from '../../data/site';

const tabs = [
  { id: 'setup', label: 'Setup' },
  { id: 'turn', label: 'Your turn' },
  { id: 'moving', label: 'Moving' },
  { id: 'winning', label: 'Winning' },
];
---
<section class="section" id="rules">
  <div class="wrap">
    <div class="section-head">
      <h2>How to play</h2>
      <p class="lede">Build the mountain as you climb it. First on the Summit wins.</p>
    </div>

    <figure class="video glass" id="video">
      <video controls playsinline preload="none" poster={video.poster} width="1920" height="1080">
        <source src={video.src} type="video/mp4" />
        <a href={video.src}>Download the how-to-play video</a>
      </video>
      <figcaption>The whole game in {video.length}, with voice-over and subtitles.</figcaption>
    </figure>

    <div class="rules" data-rules>
      <div class="tabs" role="tablist" aria-label="How to play" hidden>
        {tabs.map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="tab-number" aria-hidden="true">{i + 1}</span>{t.label}
          </button>
        ))}
      </div>

      <!-- 1. Setup -->
      <div class="panel glass" role="tabpanel" id="panel-setup" aria-labelledby="tab-setup">
        <h3 class="panel-title">Setup</h3>
        <SetupDiagram />
        <p class="tip"><strong>First game?</strong> Play the Short mountain, about 30 minutes.</p>
      </div>

      <!-- 2. Your turn -->
      <div class="panel glass" role="tabpanel" id="panel-turn" aria-labelledby="tab-turn">
        <h3 class="panel-title">Your turn</h3>
        <RoundDiagram />
        <TurnExample />
      </div>

      <!-- 3. Moving -->
      <div class="panel glass" role="tabpanel" id="panel-moving" aria-labelledby="tab-moving">
        <h3 class="panel-title">Moving</h3>
        <MoveDiagram />
        <ul class="costs" aria-label="Energy to enter a tile">
          {[...elevations].reverse().map((el) => (
            <li class={`e${el.level}`}>
              <span class="hex-badge" aria-hidden="true">{el.level}</span>
              <span>Elevation {el.level}<small>{el.frame} frame</small></span>
              <strong>{el.cost}</strong>
            </li>
          ))}
          <li class="summit">
            <span class="hex-badge" aria-hidden="true"><Icon name="summit" size="1.272em" /></span>
            <span>Summit<small>Short, Standard, Expedition</small></span>
            <strong>{mountains.map((m) => m.summit).join(' / ')}</strong>
          </li>
        </ul>
        <MoveRules />
        <ViewpointDiagram />
      </div>

      <!-- 4. Winning -->
      <div class="panel glass" role="tabpanel" id="panel-winning" aria-labelledby="tab-winning">
        <h3 class="panel-title">Winning</h3>
        <WinDiagram />
        <SummitDiagram />
      </div>
    </div>

    <p class="more"><a href="#rulebook">Read the full rulebook</a></p>
  </div>
</section>

<style>
  .video { margin: 0 0 var(--s-l); padding: var(--s-xs); border-radius: var(--r-l); max-width: 54rem; }
  .video video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: var(--r-m); background: var(--paper); }
  .video figcaption { padding: var(--s-xs) var(--s-2xs) var(--s-3xs); font-size: var(--step--1); color: var(--ink-soft); }

  .rules { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-s); } /* one column, never wider than the screen */

  /* Tabs: four numbered steps of one sequence */
  .tabs { display: flex; flex-wrap: wrap; gap: var(--s-2xs); }
  .tabs[hidden] { display: none; }
  [role='tab'] {
    display: inline-flex; align-items: center; gap: var(--s-xs);
    min-height: 2.618rem; padding: var(--s-2xs) var(--s-m) var(--s-2xs) var(--s-2xs);
    border: 1px solid var(--glass-edge); border-radius: 999px;
    background: var(--glass-fill);
    -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    font-weight: 600; font-size: var(--step--1);
    cursor: pointer;
    transition: background var(--t-fast) var(--ease), color var(--t-fast);
  }
  [role='tab']:hover { background: var(--glass-hover-fill); color: var(--forest); }
  [role='tab'][aria-selected='true'] { background: var(--forest); border-color: var(--forest); color: #fff; }
  .tab-number {
    display: grid; place-items: center; width: 1.618rem; aspect-ratio: 1.1547;
    clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
    background: var(--forest); color: #fff; font-family: var(--font-display); font-size: var(--step--1);
  }
  [aria-selected='true'] .tab-number { background: #fff; color: var(--forest); }

  /* With JavaScript only the chosen panel shows; without it, all four stack */
  .rules.tabbed .panel:not(.active) { display: none; }
  .rules.tabbed .panel-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .panel {
    display: grid; gap: var(--s-m); align-content: start;
    padding: var(--s-l);
    border-radius: var(--r-l);
  }
  .panel.active { animation: panel-in var(--t-mid) var(--ease); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(0.382rem); } }
  @media (max-width: 40rem) { .panel { padding: var(--s-m); } }
  @media (max-width: 24rem) { .panel { padding: var(--s-s); } }
  .panel { grid-template-columns: minmax(0, 1fr); }
  .panel-title { font-size: var(--step-2); }

  /* Moving: the price of a step per elevation, as a short ladder */
  .costs { list-style: none; padding: 0; display: grid; gap: var(--s-2xs); grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); }
  .costs li {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s-xs);
    padding: var(--s-xs) var(--s-s); border-radius: var(--r-m);
    background: color-mix(in srgb, var(--c, var(--gold)) 10%, rgb(255 255 255 / 0.6));
    box-shadow: inset 0.236rem 0 0 var(--c, var(--gold));
  }
  .costs .hex-badge { width: 1.618rem; font-size: var(--step--1); }
  .costs .summit .hex-badge { background: var(--gold); }
  .costs span:nth-child(2) { display: grid; line-height: 1.25; font-weight: 600; font-size: var(--step--1); }
  .costs small { font-weight: 400; color: var(--ink-soft); }
  .costs strong { font-family: var(--font-display); font-weight: 400; font-size: var(--step-2); line-height: 1; white-space: nowrap; }
  .costs .summit strong { font-size: var(--step-1); }
  .tip {
    padding: var(--s-xs) var(--s-m);
    border-radius: var(--r-m);
    background: rgb(243 227 198 / 0.55);
    box-shadow: inset 0.236rem 0 0 var(--gold);
    max-width: none;
  }
  .tip strong { font-family: var(--font-display); font-weight: 400; margin-right: 0.3em; }

  .more { margin-top: var(--s-s); font-weight: 600; font-size: var(--step--1); }
</style>

<script>
  // Accessible tabs (WAI-ARIA pattern): click or arrow keys switch panels; Home/End jump to the first/last.
  for (const root of document.querySelectorAll<HTMLElement>('[data-rules]')) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!);

    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[k].classList.toggle('active', on);
      });
      if (focus) tabs[i].focus();
    };

    list.hidden = false;
    root.classList.add('tabbed');
    panels.forEach((p) => (p.tabIndex = 0));
    select(0);

    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    list.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select((next + tabs.length) % tabs.length, true);
    });
  }
</script>
