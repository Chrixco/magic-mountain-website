---
import { asset } from '../../data/site';
// Sticky header: logo, section links, the mountain builder button and the publishers call to action (both kept on phones).
---
<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="#top" aria-label="Magic Mountain, back to top">
      <!-- logo: Final Design/Logo/MagicMountain_Logo_final.svg -->
      <img src={asset('logo.svg')} alt="" width="26" height="26" />
      <span>Magic Mountain</span>
    </a>
    <nav aria-label="Sections">
      <a href="#rules">How to play</a>
      <a class="nav-build" href="#play">
        <svg viewBox="-24 -24 48 48" width="1.272em" height="1.272em" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linejoin="round" aria-hidden="true"><polygon points="20,0 10,17.3 -10,17.3 -20,0 -10,-17.3 10,-17.3"/><path d="M 0,-8 v 16 M -8,0 h 16" stroke-linecap="round"/></svg>
        Build a mountain
      </a>
      <a href="#table">Prototype</a>
      <a class="nav-cta" href="#publishers">For publishers</a>
    </nav>
  </div>
</header>

<style>
  .skip {
    position: absolute; left: var(--s-s); top: -10rem; z-index: 20;
    padding: var(--s-xs) var(--s-s); border-radius: var(--r-s);
    background: var(--ink); color: #fff;
  }
  .skip:focus { top: var(--s-s); }

  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: rgb(253 253 251 / 0.8);
    backdrop-filter: blur(12px) saturate(1.4);
    border-bottom: 1px solid rgb(195 208 217 / 0.6);
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--s-m); min-height: 3.618rem; }
  .brand img { width: 1.618em; height: 1.618em; }
  .brand {
    display: inline-flex; align-items: center; gap: var(--s-xs);
    font-family: var(--font-display); font-size: var(--step-1);
    color: var(--ink); text-decoration: none; white-space: nowrap;
  }

  nav { display: flex; align-items: center; gap: var(--s-m); font-size: var(--step--1); font-weight: 600; }
  nav a { color: var(--ink-soft); text-decoration: none; padding-block: var(--s-2xs); }
  nav a:hover { color: var(--forest); }
  nav .nav-cta {
    padding: var(--s-3xs) var(--s-s); border-radius: 999px; white-space: nowrap;
    color: #fff; background: var(--forest);
    transition: background var(--t-fast) var(--ease);
  }
  nav .nav-cta:hover { color: #fff; background: var(--forest-hover); }
  nav .nav-build {
    display: inline-flex; align-items: center; gap: var(--s-2xs);
    padding: var(--s-3xs) var(--s-s); border-radius: 999px; white-space: nowrap;
    color: var(--ink); border: 1px solid var(--gold); background: rgb(243 227 198 / 0.45);
    transition: background var(--t-fast) var(--ease), color var(--t-fast);
  }
  nav .nav-build svg { color: var(--gold); flex: none; }
  .brand { flex: none; }
  nav .nav-build:hover { color: var(--ink); background: var(--gold-soft); }

  @media (max-width: 44rem) {
    nav a:not(.nav-cta, .nav-build) { display: none; }
    nav { gap: var(--s-xs); }
    .brand { font-size: var(--step-0); }
  }
  @media (max-width: 27rem) {
    .brand span { display: none; } /* the logo alone, so both buttons fit */
  }
  @media (max-width: 22rem) {
    .header-inner { gap: var(--s-2xs); }
    nav { gap: var(--s-2xs); }
    nav .nav-build svg { display: none; }
    nav .nav-build, nav .nav-cta { padding-inline: var(--s-xs); }
  }
</style>
