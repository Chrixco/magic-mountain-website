---
// Three mountains in one box: Short, Standard and Expedition, each with its Summit tile.
import Icon from '../Icon.astro';
import { mountains, gearName } from '../../data/game';
import { asset, links } from '../../data/site';
---
<section class="section" id="mountains">
  <div class="wrap">
    <div class="section-head">
      <h2>Three mountains in one box</h2>
      <p>The same fourteen frames build a quick family climb or a full expedition. Arrange them any way you like; there are no connection rules.</p>
    </div>

    <ul class="peaks">
      {mountains.map((m) => (
        <li class={`peak glass e${m.frame}`}>
          <div class="peak-head">
            <h3>{m.name}</h3>
            <img
              src={asset(`tiles/summit_${m.name.toLowerCase()}_large.webp`)}
              alt={`${m.name} Summit tile: ${m.summit} Energy, needs ${m.gear.map((g) => gearName[g]).join(', ')}.`}
              width="219" height="190" loading="lazy" decoding="async" data-tilt="tile"
            />
          </div>
          <p>{m.note}</p>
          <dl>
            <div><dt>Highest frame</dt><dd><span class="hex-badge" aria-hidden="true">{m.frame}</span> Elevation {m.frame}</dd></div>
            <div><dt>Summit step</dt><dd>{m.summit} Energy</dd></div>
            <div>
              <dt>Gear to summit</dt>
              <dd class="gear-row">{m.gear.map((g) => <span class="gear-chip"><Icon name={g} size="1.272em" />{gearName[g]}</span>)}</dd>
            </div>
          </dl>
        </li>
      ))}
    </ul>

    <div class="cta glass">
      <p><strong>Pick a size, then build it.</strong> Every layout on this page uses only the frames in the box.</p>
      <div class="actions">
        <a class="button" href="#play">Shuffle a mountain</a>
        <a class="button ghost" href={links.rulebook} download>Download the rulebook</a>
      </div>
    </div>
  </div>
</section>

<style>
  .peaks {
    list-style: none; padding: 0;
    display: grid; gap: var(--s-m); grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .peak {
    display: grid; gap: var(--s-s); align-content: start;
    padding: var(--s-m);
    border-radius: var(--r-l);
    box-shadow: var(--glass-shadow), inset 0 0.382rem 0 var(--c); /* glass with a stripe in the frame colour */
  }
  .peak h3 { font-size: var(--step-2); }
  .peak-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-s); }
  .peak-head img {
    width: 6.854rem; height: auto; flex: none;
    margin-block: calc(-1 * var(--s-xs));
    filter: drop-shadow(0 4px 6px rgb(34 48 60 / 0.3));
  }
  .peak > p { color: var(--ink-soft); }
  .peak dl { display: grid; gap: var(--s-xs); font-size: var(--step--1); }
  .peak dt { color: var(--ink-soft); }
  .peak dd { font-weight: 600; display: flex; align-items: center; gap: var(--s-2xs); flex-wrap: wrap; margin-top: var(--s-3xs); }
  .peak .hex-badge { width: 1.618rem; font-size: var(--step--1); }

  .cta {
    margin-top: var(--s-l);
    display: grid; gap: var(--s-s) var(--s-l); align-items: center;
    padding: var(--s-m) var(--s-l);
    border-radius: var(--r-l);
  }
  @media (min-width: 56rem) {
    .cta { grid-template-columns: 1.618fr 1fr; }
    .cta .actions { justify-content: flex-end; }
  }
  .cta p { color: var(--ink-soft); }
  .cta strong { display: block; font-family: var(--font-display); font-weight: 400; font-size: var(--step-1); color: var(--ink); }
</style>
