---
// "Build your mountain": one of ours, one from players, or your own — the interactive mountain builder.
import MountainBuilder from '../MountainBuilder.astro';
---
<section class="section" id="play">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker">No printed board</p>
      <h2>Build your mountain</h2>
      <p class="lede">Every game, a new mountain. Lay out the frames, then fill them tile by tile as you climb.</p>
      <p>The START tiles are placed so every seat gets the same climb to the Summit.</p>
    </div>
    <MountainBuilder />
  </div>
</section>

<style>
  .kicker {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: var(--s-2xs);
  }
</style>
