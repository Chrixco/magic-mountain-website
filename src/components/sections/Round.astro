---
// One round, step by step, beside a fan of three Day cards.
import { Image } from 'astro:assets';
import day02 from '../../assets/cards/day-02.png';
import day12 from '../../assets/cards/day-12.png';
import day39 from '../../assets/cards/day-39.png';

const steps = [
  ['Reveal the Day card', 'Clear skies, a blizzard, a spring thaw. The card changes movement costs for the whole round.'],
  ['Collect your energy', 'Your Base Camp gives 4 Energy, plus whatever your food provisions pay out. Energy never carries over.'],
  ['Spend it', 'Buy terrain, gear or food, photograph a viewpoint, trade with other players, and climb as far as your energy and equipment allow.'],
  ['Pass to the left', 'Unused energy is lost. The next climber faces the same sky.'],
];

const dayCards = [
  { src: day02, alt: 'Day card: “A gentle breeze carries the scent of the mountain’s beauty.” All movement costs 1 Energy less this round.' },
  { src: day12, alt: 'Day card: “A sudden blizzard limits visibility.” No movement this round, unless you are on Elevation 1–2.' },
  { src: day39, alt: 'Day card: “A helicopter drops fresh supplies at base camp.” Each player takes one free equipment card of their choice.' },
];
---
<section class="section" id="round">
  <div class="wrap golden flip">
    <div class="stack-m">
      <div class="section-head">
        <h2>One round is one day on the mountain</h2>
        <p>Each player takes one full turn. The weather changes for everyone at once, so bad luck reads as weather, never as a personal grudge.</p>
      </div>
      <ol class="steps">
        {steps.map(([title, text]) => <li><h3>{title}</h3><p>{text}</p></li>)}
      </ol>
    </div>

    <div class="fan" aria-label="Three Day cards">
      {dayCards.map((card) => (
        <div class="fan-card" data-tilt="card" data-zoom>
          <Image src={card.src} alt={card.alt} widths={[360, 540, 720, 1050]} sizes="(min-width: 56rem) 24rem, 70vw" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Steps are a real sequence, so they are numbered (in hexagons) */
  .steps { list-style: none; padding: 0; counter-reset: step; display: grid; gap: var(--s-m); }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 2.618rem 1fr; column-gap: var(--s-s); }
  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    display: grid; place-items: center; width: 2.618rem; aspect-ratio: 1.1547;
    clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
    background: var(--forest); color: #fff; font-family: var(--font-display); font-size: var(--step-1);
  }
  .steps h3 { font-size: var(--step-1); }
  .steps p { color: var(--ink-soft); }

  /* Three cards fanned in a golden-ratio column; they spread a little on hover */
  .fan { position: relative; aspect-ratio: 1 / 1.618; max-width: 26rem; margin-inline: auto; width: 100%; }
  .fan-card {
    position: absolute; width: 85.4%; left: 7.3%;
    border-radius: var(--r-m); box-shadow: var(--shadow);
    transition: transform var(--t-slow) var(--ease), rotate var(--t-slow) var(--ease), translate var(--t-slow) var(--ease);
  }
  .fan-card :global(img) { display: block; width: 100%; height: auto; }
  .fan-card:nth-child(1) { top: 4%; rotate: -5deg; }
  .fan-card:nth-child(2) { top: 34%; rotate: 3deg; z-index: 1; }
  .fan-card:nth-child(3) { top: 64%; rotate: -2deg; }
  .fan:hover .fan-card:nth-child(1) { rotate: -7deg; translate: -4% 0; }
  .fan:hover .fan-card:nth-child(3) { rotate: 0deg; translate: 4% 0; }
  .fan-card:hover { z-index: 2; }
  @media (min-width: 56rem) { .fan { position: sticky; top: var(--s-xl); } }
</style>
